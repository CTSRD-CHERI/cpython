# See: man pkg-config
prefix=/home/qianhuiwang/cpython/build-benchmark
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: Python
Description: Build a C extension for Python
Requires:
Version: 3.12
Libs.private: -ldl  -lutil
Libs: -L${libdir} 
Cflags: -I${includedir}/python3.12d
